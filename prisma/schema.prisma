// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Role {
  PARENT
  ADMIN
}

enum Gender {
  MALE
  FEMALE
}

enum OrderType {
  DAILY
  MONTHLY
}

enum OrderStatus {
  PENDING   // created, awaiting payment
  PAID      // payment verified
  FAILED    // payment failed / cancelled at gateway
  CANCELLED // every item was cancelled (fully refunded, nothing left to serve)
}

enum OrderItemStatus {
  ACTIVE    // will be served
  CANCELLED // parent or admin cancelled this specific day; refunded if the order was PAID
}

enum PortionType {
  HALF // نیم پرس
  FULL // تمام پرس
}

enum PaymentMethod {
  GATEWAY // Zarinpal
  WALLET  // paid instantly from the user's wallet balance
}

// ---------- Core Auth ----------

model User {
  id        String   @id @default(cuid())
  phone     String   @unique // e.g. 09122122121
  role      Role     @default(PARENT)

  // OTP login fields (single active code per user)
  otpCode       String?
  otpExpiresAt  DateTime?
  otpLastSentAt DateTime?

  walletBalance Int @default(0) // تومن. Never goes negative — enforced in application code inside a transaction.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  children             Child[]
  orders               Order[]
  walletTransactions   WalletTransaction[]
  walletAdjustmentsMade WalletTransaction[] @relation("WalletTransactionAdmin")

  @@map("users")
}

// ---------- Reference / Lookup tables ----------

model School {
  id   String @id @default(cuid())
  name String @unique

  children Child[]

  @@map("schools")
}

model Grade {
  id    String @id @default(cuid())
  name  String @unique // e.g. "پایه اول ابتدایی"
  order Int    @unique // 1-12, guarantees dropdown sort order regardless of insertion

  children Child[]

  @@map("grades")
}

// ---------- Child / Registration ----------

model Child {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  birthDate    DateTime // stored as real Gregorian DateTime, converted to Jalali only in UI
  nationalCode String   @unique // 10-digit Iranian national code, validated via Zod checksum
  gender       Gender

  gradeId  String
  grade    Grade  @relation(fields: [gradeId], references: [id])

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  parentId String
  parent   User   @relation(fields: [parentId], references: [id])

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("children")
}

// ---------- Menu ----------

model Food {
  id   String @id @default(cuid())
  name String @unique

  menuItems MenuItem[]

  createdAt DateTime @default(now())

  @@map("foods")
}

// A topping/side dish (e.g. موز, نوشابه) a parent can optionally add to a
// reserved meal. Unlike Food, sides are NOT scheduled per-date — they're
// always available to attach to any OrderItem, admin-managed like Food.
model Side {
  id   String @id @default(cuid())
  name String @unique

  orderItems OrderItemSide[]

  createdAt DateTime @default(now())

  @@map("sides")
}

// A specific food offered on a specific calendar date.
// A given date can have multiple MenuItem rows (2-3 food choices per day).
model MenuItem {
  id     String   @id @default(cuid())
  date   DateTime // normalized to midnight UTC, represents a single calendar day
  foodId String
  food   Food     @relation(fields: [foodId], references: [id])

  orderItems OrderItem[]

  createdAt DateTime @default(now())

  @@unique([date, foodId]) // can't add the same food twice on the same day
  @@index([date])
  @@map("menu_items")
}

// An exception override: a specific date that is closed beyond the
// default rule (Thursdays/Fridays are always closed).
// Admin can only ADD closures here, never reopen a default-closed day.
model ClosedDay {
  id     String   @id @default(cuid())
  date   DateTime @unique // normalized to midnight UTC
  reason String? // optional note for admin's own reference

  createdAt DateTime @default(now())

  @@map("closed_days")
}

// Single-row settings table for portion pricing (تومن, whole numbers).
// Daily and monthly reservations are priced independently.
model PortionPricing {
  id                 String   @id @default(cuid())
  dailyHalfPrice     Int      // نیم پرس روزانه
  dailyFullPrice     Int      // تمام پرس روزانه
  monthlyHalfPrice   Int      // نیم پرس ماهانه
  monthlyFullPrice   Int      // تمام پرس ماهانه
  updatedAt          DateTime @updatedAt

  @@map("portion_pricing")
}

// ---------- Orders / Payment ----------

model Order {
  id     String      @id @default(cuid())
  type   OrderType
  status OrderStatus @default(PENDING)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  totalAmount   Int           // sum of all OrderItem prices, in تومن, snapshotted at creation
  paymentMethod PaymentMethod @default(GATEWAY)

  // Zarinpal payment tracking (only relevant when paymentMethod = GATEWAY)
  paymentAuthority  String? // "Authority" returned by Zarinpal on request
  paymentRefId      String? // "RefID" returned by Zarinpal on successful verify
  trackingCode      String? @unique // our own human-friendly code shown to the parent

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("orders")
}

// One reserved meal for one child on one day.
model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  childId String
  child   Child  @relation(fields: [childId], references: [id])

  date DateTime // the calendar day this meal is for

  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  portionType PortionType
  unitPrice   Int         // price snapshot at time of order (تومن) — protects historical accuracy

  note String?

  sides OrderItemSide[] // optional toppings/sides attached to this meal (e.g. موز, نوشابه)

  status       OrderItemStatus @default(ACTIVE)
  cancelledAt  DateTime?
  cancelReason String?         // توضیحات — required when an admin cancels, optional/omitted for parent self-cancel
  cancelledBy  String?         // userId of whoever cancelled it (parent or admin) — null if never cancelled

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([childId])
  // NOTE: the DB-level uniqueness guarantee here only applies to ACTIVE
  // rows — see the partial unique index added via raw SQL in the
  // migration (order_items_child_date_active_unique). A cancelled item
  // must NOT block rebooking the same child+date. This @@unique below is
  // intentionally REMOVED from the Prisma-managed schema (kept only as
  // the fast-path app-level check in create-order.ts); the actual DB
  // constraint lives in the partial index instead, since Prisma doesn't
  // support partial/filtered unique constraints natively.
  @@map("order_items")
}

// Explicit join: which sides/toppings are attached to a given OrderItem.
// A parent can pick any number of sides (zero or more) — free, optional,
// shown alongside the food name everywhere the meal itself is shown.
model OrderItemSide {
  id String @id @default(cuid())

  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  sideId String
  side   Side   @relation(fields: [sideId], references: [id])

  @@unique([orderItemId, sideId]) // can't attach the same side twice to one meal
  @@index([orderItemId])
  @@map("order_item_sides")
}

// ---------- Wallet ----------

enum WalletTransactionType {
  CREDIT // money added to the wallet (admin top-up, or a refund)
  DEBIT  // money removed from the wallet (admin deduction, or spent on an order)
}

enum WalletTransactionReason {
  ADMIN_ADJUSTMENT     // manual add/deduct by an admin
  ORDER_REFUND         // order cancelled (by parent or admin) -> refunded to wallet
  WALLET_PAYMENT       // wallet used to pay for an order
}

// Append-only ledger of every wallet balance change. User.walletBalance is
// a denormalized running total kept in sync with this table inside the
// same DB transaction as each mutation — this table exists so every
// change has a reason, an optional admin note, and a timestamp, and so
// the balance can always be audited/recomputed if ever needed.
model WalletTransaction {
  id     String                  @id @default(cuid())
  userId String
  user   User                    @relation(fields: [userId], references: [id])

  type   WalletTransactionType
  reason WalletTransactionReason
  amount Int // always positive; `type` determines the direction

  note String? // optional توضیحات — required for ADMIN_ADJUSTMENT in the API layer, freeform otherwise

  // Set when an admin performed this action manually (ADMIN_ADJUSTMENT).
  // Null for system-generated entries (refunds, wallet payments).
  adminId String?
  admin   User?   @relation("WalletTransactionAdmin", fields: [adminId], references: [id])

  // Optional link back to the order that caused this entry (refunds,
  // wallet payments) — null for pure admin adjustments.
  orderId String?

  balanceAfter Int // wallet balance snapshot immediately after this entry, for easy display without recomputation

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("wallet_transactions")
}




